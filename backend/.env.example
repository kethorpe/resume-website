# Copy to .env for local development (npm run dev).
# Values come from `terraform output` after you deploy once.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Leave TABLE_NAME empty to use an in-memory store locally (data resets on restart).
# Set it (and your AWS credentials) to use the real DynamoDB table.
TABLE_NAME=
PORT=3001

# Contact form. With these unset, messages are kept in memory and email is skipped (a warning is logged).
MESSAGES_TABLE=
RATE_LIMIT_TABLE=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Optional tuning (defaults shown)
# CONTACT_IP_LIMIT_PER_HOUR=3
# CONTACT_GLOBAL_LIMIT_PER_DAY=50
