# Copy to .env for local development (npm run dev).
# Values come from `terraform output` after you deploy once.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Leave TABLE_NAME empty to use an in-memory store locally (data resets on restart).
# Set it (and your AWS credentials) to use the real DynamoDB table.
TABLE_NAME=
PORT=3001
